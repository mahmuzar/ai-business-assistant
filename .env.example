# Application
NODE_ENV=development
APP_PORT=3000
APP_METRICS_PORT=9090
APP_LOG_LEVEL=debug
APP_SERVICE_NAME=ai-business-assistant
APP_SERVICE_VERSION=0.1.0

#Knowledge
DOCUMENTS_BASE_PATH=./documents

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_assistant
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ai_assistant:

# Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ai-business-assistant
KAFKA_GROUP_ID=ai-assistant-group
KAFKA_TOPIC_MESSAGES=messaging.message.received
KAFKA_TOPIC_LEADS_CREATED=leads.created
KAFKA_TOPIC_LEADS_SYNCED=leads.synced
KAFKA_TOPIC_BROADCASTS_SCHEDULED=broadcasts.scheduled
KAFKA_TOPIC_KNOWLEDGE_UPLOADED=knowledge.document.uploaded
KAFKA_TOPIC_PAYMENTS_COMPLETED=payments.completed
KAFKA_SASL_MECHANISM=none
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_ENABLED=false

# GigaChat API
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_EMBEDDING_MODEL=Embeddings-GigaChat
GIGACHAT_MAX_TOKENS=4096
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_TIMEOUT_MS=30000

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_API_URL=https://api.telegram.org

# VK MAX
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_PATH=/webhook/max
MAX_API_URL=https://botapi.max.ru

# Payment: YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_RETURN_URL=https://example.com/payment/success
YOOKASSA_API_URL=https://api.yookassa.ru/v3

# Payment: Tinkoff
TINKOFF_TERMINAL_KEY=
TINKOFF_SECRET_KEY=
TINKOFF_WEBHOOK_URL=https://example.com/webhook/tinkoff
TINKOFF_API_URL=https://securepay.tinkoff.ru/v2

# CRM: AmoCRM
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://example.com/crm/amocrm/callback

# CRM: Bitrix24
BITRIX24_WEBHOOK_URL=
BITRIX24_ACCESS_TOKEN=

# File Storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-assistant-documents
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# Encryption
ENCRYPTION_KEY=change-me-to-32-byte-hex-string-for-aes256
ENCRYPTION_SALT=change-me-to-random-salt-value

# Observability: OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=ai-business-assistant
OTEL_SERVICE_VERSION=0.1.0
OTEL_RESOURCE_ATTRIBUTES=environment=development
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Observability: Prometheus
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_USER_MAX=30

# RAG Configuration
RAG_MAX_DOCUMENTS_PER_TENANT=50
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Admin
ADMIN_JWT_SECRET=change-me-to-strong-random-secret
ADMIN_JWT_EXPIRES_IN=24h
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-on-first-login