{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "removeComments": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "ignoreDeprecations": ""
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "dist",
    "**/*.spec.ts"
  ],
  "assets": [
    {
      "include": "src/modules/ai/certs/**/*",
      "outDir": "dist/modules/ai/certs"
    }
  ]
}