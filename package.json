{
  "name": "ai-business-assistant",
  "version": "0.1.0",
  "type": "module",
  "description": "AI Business Assistant - SaaS Telegram/MAX bot powered by GigaChat",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker:leads": "node dist/workers/lead-worker.js",
    "start:worker:broadcasts": "node dist/workers/broadcast-worker.js",
    "start:worker:rag": "node dist/workers/rag-worker.js",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.unit.config.js",
    "test:unit": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.unit.config.js --watch",
    "test:unit:ci": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.unit.config.js --coverage --forceExit --ci",
    "test:integration": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --co…fig.ts --runInBand --watch",
    "test:integration:ci": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --coverage --forceExit --runInBand --ci",
    "test:e2e": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand --watch",
    "test:e2e:ci": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --forceExit --runInBand --ci",
    "test:all": "npm run test:unit:ci && npm run test:integration:ci && npm run test:e2e:ci",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "check:emoji": "tsx scripts/check-no-emoji.ts",
    "check:env": "tsx scripts/env-check.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.60.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.0",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@testcontainers/kafka": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.0",
    "jest": "^30.5.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.0",
    "prisma": "^7.10.0",
    "supertest": "^7.2.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "jest --findRelatedTests --passWithNoTests"
    ]
  }
}
